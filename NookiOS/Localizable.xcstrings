    "Your feed hasn't picked it up yet. Feeds are cached for up to half a minute, so it will appear in My Nook shortly.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feed hasn't picked it up yet. Feeds are cached for up to half a minute, so it will appear in My Nook shortly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードにまだ反映されていません。フィードは最大30秒キャッシュされるため、間もなくマイNookに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드에 아직 반영되지 않았습니다. 피드는 최대 30초간 캐시되므로 곧 내 Nook에 나타납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅源还没有更新。订阅源最多缓存半分钟，稍后就会出现在「我的 Nook」中。"
          }
        }
      }
    },
