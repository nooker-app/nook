    "Local settings and downloaded data can't be recovered. Your sync folder will not be changed. Nook will return to the welcome screen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local settings and downloaded data can't be recovered. Your sync folder will not be changed. Nook will return to the welcome screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル設定とダウンロード済みデータは復元できません。同期フォルダは変更されません。Nookはようこそ画面に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 설정과 다운로드 데이터는 복구할 수 없습니다. 동기화 폴더는 변경되지 않으며 Nook은 시작 화면으로 돌아갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
