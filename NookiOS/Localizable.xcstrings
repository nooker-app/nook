    "Want the original? Tap the document button at the bottom. Swipe in from the left edge to return to your list.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のページを見たいときは下部の書類ボタンをタップ。左端からスワイプするとリストに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원문이 궁금하면 하단의 문서 버튼을 누르세요. 왼쪽 가장자리에서 스와이프하면 목록으로 돌아갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想看原文？点按底部的文档按钮。从左边缘向内滑动即可返回列表。"
          }
        }
      }
    },
    "We'll copy a popular feed for you. Tap below, then paste it on the Add Feed screen. You can add any RSS link or website the same way.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人気のフィードをコピーします。下をタップして、フィード追加画面に貼り付けてください。他のRSSリンクやWebサイトも同じ方法で追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인기 피드 하나를 복사해 드릴게요. 아래를 누른 뒤 피드 추가 화면에 붙여넣으세요. 다른 RSS 링크나 웹사이트도 같은 방법으로 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会为你复制一个热门订阅。点按下方，然后在“添加订阅”界面粘贴即可。任何 RSS 链接或网站都能用同样的方式添加。"
          }
        }
      }
    },
    "Welcome to Nook": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook へようこそ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
