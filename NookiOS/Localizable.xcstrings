    "Shows how many unread articles are waiting, on the app icon. Also needs notification permission — that is what iOS calls the badge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how many unread articles are waiting, on the app icon. Also needs notification permission — that is what iOS calls the badge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読記事の件数をアプリアイコンに表示します。バッジも iOS では通知の一部なので許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽지 않은 글이 몇 개인지 앱 아이콘에 표시합니다. 배지도 iOS에서는 알림에 속해서 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用图标上显示有多少未读文章。角标在 iOS 中也属于通知，因此同样需要权限。"
          }
        }
      }
    },
