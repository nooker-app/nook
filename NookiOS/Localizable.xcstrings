          "stringUnit": {
            "state": "translated",
            "value": "自分で選んだ設定です。精密測定は約5分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 고른 설정이에요 — 정밀 측정은 약 5분이면 돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你自己选择的设置——精确测量约需 5 分钟。"
          }
        }
      }
    },
    "Your Post Is Published": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Post Is Published"
          }
        },
        "ja": {
