    "All of this is off. Turn on only what you want — you can change any of it later in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All of this is off. Turn on only what you want — you can change any of it later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてオフになっています。必要なものだけをオンにしてください。あとから設定でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 꺼져 있습니다. 원하는 것만 켜세요. 나중에 설정에서 언제든 바꿀 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下全部关闭。只打开你需要的，之后随时可以在“设置”中更改。"
          }
        }
      }
    },
