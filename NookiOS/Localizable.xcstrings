          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの設定はリーダーモードでの表示に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리더 모드로 글을 볼 때 적용되는 설정입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
