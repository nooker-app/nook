      }
    },
    "What do you like to read?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな記事を読みたいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 글을 즐겨 읽으세요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
