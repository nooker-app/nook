            "state": "translated",
            "value": "この選択では iOS に許可を求めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 선택으로는 iOS에 권한을 요청하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前选择不会向 iOS 请求任何权限。"
          }
        }
      }
    },
    "Nothing starred yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スターを付けた記事はまだありません"
          }
        },
