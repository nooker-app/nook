    "Use lowercase English letters, numbers, and hyphens. A handle is a web address, so it cannot contain Korean, Japanese, Chinese, or accented letters." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英小文字・数字・ハイフンを使ってください。ハンドルはウェブアドレスなので、日本語・韓国語・中国語やアクセント付きの文字は使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영문 소문자, 숫자, 하이픈을 사용하세요. 핸들은 웹 주소이기 때문에 한글·일본어·한자나 악센트 문자는 쓸 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用小写英文字母、数字和连字符。handle 是网址的一部分，因此不能包含中文、日文、韩文或带重音的字母。"
          }
        }
      }
    },
    "Use lowercase English letters, numbers, and hyphens. This is part of a web address, so it cannot contain Korean, Japanese, Chinese, spaces, or accented letters." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英小文字・数字・ハイフンを使ってください。これはウェブアドレスの一部なので、日本語・韓国語・中国語・空白・アクセント付きの文字は使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영문 소문자, 숫자, 하이픈을 사용하세요. 웹 주소의 일부이기 때문에 한글·일본어·한자·공백·악센트 문자는 쓸 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用小写英文字母、数字和连字符。这是网址的一部分，因此不能包含中文、日文、韩文、空格或带重音的字母。"
          }
        }
      }
    },
    "Use lowercase letters, numbers, and hyphens, at least three characters." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use lowercase letters, numbers, and hyphens, at least three characters."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小文字・数字・ハイフンを使い、3 文字以上にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소문자, 숫자, 하이픈으로 세 글자 이상 지어 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用小写字母、数字和连字符，且至少三个字符。"
          }
        }
      }
    },
    "Use one to six # markers followed by a space." : {
