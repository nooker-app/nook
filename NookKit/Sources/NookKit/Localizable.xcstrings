          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小文字・数字・ハイフンが使えます。3 文字以上にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소문자, 숫자, 하이픈을 쓸 수 있습니다. 세 글자 이상이어야 합니다."
          }
        },
        "zh-Hans" : {
