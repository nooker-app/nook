    "Not yet. Nook can only reach its own server at the moment." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ対応していません。現時点で Nook は自身のサーバーにしか接続できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 지원하지 않습니다. 현재 Nook은 자체 서버에만 연결할 수 있습니다."
          }
        },
