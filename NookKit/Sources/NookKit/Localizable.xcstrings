          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 핸들은 다른 서버의 것입니다. Nook은 자체 서버의 계정에만 로그인할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该 handle 属于另一台服务器。Nook 只能登录自有服务器上的账户。"
          }
        }
      }
    },
    "That image could not be read. Try choosing it again." : {
