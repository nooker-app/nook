    "Protects your repository. Nook stores it nowhere: it goes straight to the host that keeps your posts." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protects your repository. Nook stores it nowhere: it goes straight to the host that keeps your posts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのリポジトリを保護します。Nook はパスワードを保存しません。投稿を保管するホストに直接渡されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장소를 보호합니다. Nook은 비밀번호를 어디에도 저장하지 않고, 글을 보관하는 호스트로 곧바로 전달합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于保护你的仓库。Nook 不会保存密码，它会直接发送给保管你文章的主机。"
          }
        }
      }
    },
