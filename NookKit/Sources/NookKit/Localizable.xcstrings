    },
    "The file will be replaced with the published version of %@. What you wrote outside Nook will be gone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file will be replaced with the published version of %@. What you wrote outside Nook will be gone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルは公開中の「%@」の内容に戻ります。Nook の外で書いた内容は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일이 발행된 ‘%@’의 내용으로 되돌아갑니다. Nook 밖에서 쓴 내용은 사라집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件将被替换为已发布的《%@》。你在 Nook 之外写的内容将会消失。"
          }
        }
      }
    },
    "The invitation in that link cannot be used. It may have been used already or expired." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The invitation in that link cannot be used. It may have been used already or expired."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのリンクの招待は使用できません。すでに使われたか、有効期限が切れている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크의 초대는 사용할 수 없습니다. 이미 사용되었거나 유효기간이 지났을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
