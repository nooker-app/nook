    "That article is missing the information needed to delete it safely." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That article is missing the information needed to delete it safely."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この記事には、安全に削除するために必要な情報がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 글에는 안전하게 삭제하는 데 필요한 정보가 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这篇文章缺少安全删除所需的信息。"
          }
        }
      }
    },
    "That code was not recognised. It may have been used already or expired." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That code was not recognised. It may have been used already or expired."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコードは認識できませんでした。すでに使用済みか、期限が切れている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인식할 수 없는 코드입니다. 이미 사용됐거나 만료됐을 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法识别该代码。它可能已被使用或已过期。"
          }
        }
      }
    },
    "That email address was not accepted. Check it for typos." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのメールアドレスは受け付けられませんでした。入力に誤りがないか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이메일 주소는 사용할 수 없습니다. 오타가 없는지 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该邮箱地址未被接受。请检查是否有拼写错误。"
          }
        }
      }
    },
    "That handle and password did not match." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That handle and password did not match."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハンドルとパスワードが一致しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핸들과 비밀번호가 일치하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "handle 与密码不匹配。"
          }
        }
      }
    },
    "That handle belongs to a different server. Nook can only sign in to accounts on its own server." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのハンドルは別のサーバーのものです。Nook は自身のサーバーのアカウントにしかサインインできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 핸들은 다른 서버의 것입니다. Nook은 자체 서버의 계정에만 로그인할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该 handle 属于另一台服务器。Nook 只能登录自有服务器上的账户。"
          }
        }
      }
    },
    "That invitation has already been used up. Ask for a new one." : {
