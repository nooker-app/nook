    "Drafts are unpublished writing kept only on this device, so deleting your account does not reach them. Turn this off to keep them." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drafts are unpublished writing kept only on this device, so deleting your account does not reach them. Turn this off to keep them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書きはこの端末にだけある未公開の文章なので、アカウントを削除しても消えません。残すにはオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초안은 이 기기에만 있는 발행되지 않은 글이라, 계정을 삭제해도 사라지지 않습니다. 남겨 두려면 끄세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "草稿是仅保存在此设备上的未发布内容，删除账户不会影响它们。想保留就关闭此项。"
          }
        }
      }
    },
    "Drafts cannot be saved on this device." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drafts cannot be saved on this device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末では下書きを保存できません。"
