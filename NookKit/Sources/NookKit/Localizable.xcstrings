    "An account with this name already exists. Sign in with the password you chose when you created it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この名前のアカウントはすでに存在します。作成したときに決めたパスワードでサインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이름의 계정이 이미 있습니다. 계정을 만들 때 정한 비밀번호로 로그인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该名称的账户已存在。请使用创建时设置的密码登录。"
          }
        }
      }
    },
    "An address is needed. One is suggested from your title." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスが必要です。タイトルから候補を提案しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소가 필요합니다. 제목에서 제안된 값이 채워집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要一个地址。已根据标题给出建议。"
          }
        }
      }
    },
    "An embedded video isn't shown here." : {
