    "Nook account" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook アカウント"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook 계정"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
