    },
    "Only accounts on Nook's own server can sign in at the moment." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現時点でサインインできるのは Nook 自身のサーバーのアカウントだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재는 Nook 자체 서버의 계정만 로그인할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前只有 Nook 自有服务器上的账户可以登录。"
          }
        }
      }
    },
    "Only change this if you are testing Nook Plus itself. Accounts do not carry across servers, so switching signs you out." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only change this if you are testing Nook Plus itself. Accounts do not carry across servers, so switching signs you out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook Plus 自体をテストしている場合以外は変更しないでください。アカウントはサーバー間で共有されないため、切り替えるとサインアウトします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook Plus 자체를 테스트하는 경우가 아니라면 바꾸지 마세요. 계정은 서버 간에 공유되지 않으므로, 바꾸면 로그아웃됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非你在测试 Nook Plus 本身，否则请不要更改。账号不会跨服务器共用，切换会让你退出登录。"
          }
        }
      }
    },
    "Only new articles are tagged automatically. Use this to catch up your existing articles." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only new articles are tagged automatically. Use this to catch up your existing articles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新着記事のみ自動でタグ付けされます。既存の記事はこれで追いつけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 글만 자동으로 태그됩니다. 기존 글은 이 기능으로 채우세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
