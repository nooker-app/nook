    "No publishing account uses this email address. Check it for typos, or set up publishing first." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメールアドレスを使っている発行アカウントはありません。入力に誤りがないか確認するか、先に発行を設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이메일 주소를 사용하는 발행 계정이 없습니다. 오타를 확인하거나, 먼저 발행을 설정하세요."
          }
