    },
    "This deletes your account on the server that stores your writing." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes your account on the server that stores your writing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文章が保存されているサーバーからアカウントを削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 글이 저장된 서버에서 계정을 삭제합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将删除存储你写作的服务器上的账户。"
          }
        }
      }
    },
    "This draft is only on this device, so deleting it cannot be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This draft is only on this device, so deleting it cannot be undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この下書きはこの端末にしかないため、削除すると元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 초안은 이 기기에만 있어서 삭제하면 되돌릴 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这份草稿只在本设备上，删除后无法恢复。"
          }
        }
      }
    },
    "This is not the same as leaving Nook Plus. Leaving keeps your account and everything in it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not the same as leaving Nook Plus. Leaving keeps your account and everything in it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook Plus の退会とは異なります。退会ではアカウントとその中身はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook Plus 탈퇴와는 다릅니다. 탈퇴는 계정과 그 안의 모든 것을 남겨 둡니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这与退出 Nook Plus 不同。退出会保留你的账户及其中的一切。"
          }
        }
      }
    },
    "This is not the same as signing out, and not the same as deleting your account. Coming back needs a new invitation." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is not the same as signing out, and not the same as deleting your account. Coming back needs a new invitation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインアウトとも、アカウント削除とも異なります。再開するには新しい招待が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그아웃과 다르고, 계정 삭제와도 다릅니다. 다시 시작하려면 새 초대가 필요합니다."
