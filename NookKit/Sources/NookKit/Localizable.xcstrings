        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook 的阅读样本"
          }
        }
      }
    },
    "Not Now" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後で"
          }
        },
        "ko" : {
