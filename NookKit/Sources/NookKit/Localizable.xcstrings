        }
      }
    },
    "No reliable summary could be generated. The article may already be concise or may not contain enough readable content." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼できる要約を生成できませんでした。記事がすでに簡潔であるか、読み取れる内容が不足している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 있는 요약을 만들지 못했습니다. 글이 이미 충분히 짧거나 읽을 수 있는 내용이 부족할 수 있습니다."
