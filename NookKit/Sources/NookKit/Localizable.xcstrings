        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook 밖에서 이 파일들을 수정했습니다. 직접 발행하기 전까지는 아무것도 발행되지 않고, 파일은 수정한 그대로 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
