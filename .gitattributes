# The reader's legibility engine: one ~900 KB line of base64, generated by
# tools/build-legibility.sh. Git would otherwise treat it as text and print the
# whole thing as a single changed line, which is unreadable in a terminal and
# unrenderable on GitHub. Read tools/legibility.pin to see what changed.
NookKit/Sources/NookKit/Legibility.html -diff linguist-generated=true

# Mozilla's Readability, vendored verbatim.
NookKit/Sources/NookKit/Readability.js linguist-vendored=true
