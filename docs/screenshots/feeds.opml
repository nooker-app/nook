<?xml version='1.0' encoding='utf-8'?>
<opml version="2.0">
  <head>
    <title>Nook — English sample feeds</title>
  </head>
  <body>
    <outline text="Design" title="Design">
      <outline type="rss" text="CSS-Tricks" title="CSS-Tricks" xmlUrl="https://css-tricks.com/feed/" htmlUrl="https://css-tricks.com/" />
      <outline type="rss" text="Smashing Magazine" title="Smashing Magazine" xmlUrl="https://www.smashingmagazine.com/feed/" htmlUrl="https://www.smashingmagazine.com/" />
    </outline>
    <outline text="Science" title="Science">
      <outline type="rss" text="NASA Image of the Day" title="NASA Image of the Day" xmlUrl="https://www.nasa.gov/feeds/iotd-feed/" htmlUrl="https://www.nasa.gov/image-of-the-day/" />
    </outline>
    <outline text="Technology" title="Technology">
      <outline type="rss" text="Cloudflare Blog" title="Cloudflare Blog" xmlUrl="https://blog.cloudflare.com/rss/" htmlUrl="https://blog.cloudflare.com/" />
      <outline type="rss" text="Simon Willison's Weblog" title="Simon Willison's Weblog" xmlUrl="https://simonwillison.net/atom/everything/" htmlUrl="https://simonwillison.net/" />
    </outline>
  </body>
</opml>